# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# For local MongoDB: mongodb://localhost:27017/trustguard
MONGODB_URI=mongodb+srv://admin:trustguard_password@cluster0.mongodb.net/trustguard?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=trustguard_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Google Gemini API
# Get your API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# CORS Allowed Origins (Comma-separated for local and production Vercel domains)
# Example: http://localhost:5173,https://your-frontend-app.vercel.app
CLIENT_URL=http://localhost:5173,http://localhost:3000,https://trustguard-ai.vercel.app

# Gateway Rate Limiting (requests per 15 minutes per IP)
RATE_LIMIT_MAX=300

# Supabase Cloud Database Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
